{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "astro.config.mjs",
    "tailwind.config.mjs",
    "scripts/**/*",
    "src/**/*"
  ],
  "exclude": ["dist", "node_modules"]
}
