---
import BodyGraphShell from "../React/BodyGraphShell.tsx";
import SkillsList from "../React/SkillsList.tsx";
import { Image } from 'astro:assets';
import profileImg from '../assets/profile2.png';

const techStack = [
  { name: 'LangChain · LangGraph', icon: '/svg/agent-orchestration.svg' },
  { name: 'React Native', icon: '/svg/react.svg' },
  { name: 'Flutter', icon: '/svg/flutter.svg' },
  { name: 'React', icon: '/svg/react.svg' },
  { name: 'Android', icon: '/svg/android.svg' },
  { name: 'Node.js', icon: '/svg/nodejs.svg' },
  { name: 'MongoDB', icon: '/svg/mongodb.svg' },
  { name: 'MariaDB', icon: '/svg/mariadb.svg' },
  { name: 'PostgreSQL', icon: '/svg/postsql.svg' },
  { name: 'Redis', icon: '/svg/redis.svg' },
  { name: 'Kubernetes', icon: '/svg/kubernetes.svg' },
  { name: 'Docker', icon: '/svg/docker.svg' },
  { name: 'GCP', icon: '/svg/gcp.svg' },
  { name: 'AWS', icon: '/svg/aws.svg' },
  { name: 'TypeScript', icon: '/svg/typescript.svg' },
];

---

<section class="text-[var(--white)] mt-12 md:mt-0 relative overflow-x-hidden overflow-y-visible" id="home">
  <!-- Background Effects -->
  <div class="absolute top-1/4 -left-20 w-96 h-96 bg-[#5b13ec]/20 rounded-full blur-[120px] pointer-events-none" />
  <div class="absolute bottom-1/4 -right-20 w-[500px] h-[500px] bg-[#5b13ec]/10 rounded-full blur-[150px] pointer-events-none" />
  
  <div data-page-container class="page-container space-y-8 md:py-36 pb-14 relative z-10">
    <div class="text-left space-y-4">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 md:w-16 md:h-16 rounded-full overflow-hidden ring-2 ring-[var(--sec)] ring-opacity-30 flex-shrink-0">
          <Image src={profileImg} alt="Bogyun Kim" width={64} height={64} class="w-full h-full object-cover" />
        </div>
        <p class="text-md md:text-lg text-[var(--white-icon)] shiny-white">
          Hi, I'm Bogyun Kim
        </p>
      </div>
      <div
        class="flex flex-col lg:flex-row lg:items-center space-y-4 lg:space-y-0 lg:space-x-8 md:gap-4"
      >
        <h1
          class="text-[var(--white)] text-4xl sm:text-5xl md:text-6xl font-medium text-pretty leading-[0.95] lg:min-w-[420px]"
        >
          AI Agent <br />
          <span class="text-[var(--sec)]">&amp;</span> Full-Stack <br />
          Engineer
        </h1>
        <p class="text-md md:text-xl text-[var(--white-icon)] leading-relaxed">
          멀티플랫폼 제품 개발 경험을 바탕으로
          <span class="text-[var(--sec)] shiny-sec">LangChain·LangGraph 기반 Agent 워크플로</span>,
          문서·DB 연동 RAG, Kubernetes 운영 환경을 설계하고 구현합니다.
        </p>
      </div>
      <div class="flex justify-start gap-2 pt-3 md:pt-6">
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://github.com/k4771kim"
          aria-label="GitHub"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-8"
          >
            <path
              d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
            ></path>
          </svg>
        </a>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://www.linkedin.com/in/bogyun-kim-9805ba147"
          aria-label="LinkedIn"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-8"
          >
            <path
              d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"
            ></path>
          </svg>
        </a>
        <a
          href="mailto:k4771kim@naver.com"
          aria-label="Email"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="size-8">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>
      </div>
    </div>

    <div class="tech-marquee relative overflow-x-hidden py-8">
      <div class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-[var(--background)] to-transparent z-20"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-[var(--background)] to-transparent z-20"></div>

      <div class="tech-track flex w-max items-center gap-12 md:gap-20">
        {[...techStack, ...techStack, ...techStack].map((skill, idx) => (
          <div
            class="tech-chip flex items-center gap-2.5 group transition-all duration-300"
            aria-hidden={idx >= techStack.length}
          >
            <img src={skill.icon} alt="" class="tech-icon" width="28" height="28" loading="lazy" />
            <span class="text-lg font-medium text-[var(--white-icon)]">
              {skill.name}
            </span>
          </div>
        ))}
      </div>
    </div>

    <div class="flex flex-col lg:flex-row items-center gap-8">
      <SkillsList client:load />
      <div
        class="relative flex justify-center w-full pt-16 md:pt-9 lg:ml-16"
      >
        <div data-bodygraph-region class="relative aspect-square w-[min(78vw,320px)] md:w-[min(60vw,360px)] flex justify-center items-center">
          <div class="absolute inset-0 bg-[#5b13ec]/20 rounded-full blur-[100px] animate-pulse"></div>
          <div class="relative w-full h-full bg-white/[0.03] backdrop-blur-xl rounded-full flex justify-center items-center border border-[#5b13ec]/20 overflow-hidden shadow-[0_0_30px_rgba(91,19,236,0.1)]">
            <div class="absolute inset-0 w-full h-full">
              <BodyGraphShell client:visible={{ rootMargin: '200px' }} />
            </div>
          </div>
          
          <!-- Floating Icons -->
          <div class="absolute top-10 right-10 p-3 bg-white/[0.03] backdrop-blur-xl border border-white/10 rounded-xl shadow-[0_0_30px_rgba(91,19,236,0.3)] floating-icon-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5b13ec" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
              <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
              <line x1="12" y1="22.08" x2="12" y2="12" />
            </svg>
          </div>
          
          <div class="absolute bottom-20 left-4 p-3 bg-white/[0.03] backdrop-blur-xl border border-white/10 rounded-xl floating-icon-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5b13ec" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
            </svg>
          </div>
          
          <div class="absolute top-1/2 left-2 p-3 bg-white/[0.03] backdrop-blur-xl border border-white/10 rounded-xl floating-icon-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5b13ec" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  .shiny-white {
    background: linear-gradient(135deg, var(--white) 25%, #ffffff 50%, var(--white) 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }

  @keyframes float1 {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes float2 {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-15px);
    }
  }

  @keyframes float3 {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  .floating-icon-1 {
    animation: float1 4s ease-in-out infinite;
  }

  .floating-icon-2 {
    animation: float2 5s ease-in-out infinite 1s;
  }

  .floating-icon-3 {
    animation: float3 6s ease-in-out infinite 0.5s;
  }

  .tech-track {
    animation: stack-slide-left 60s linear infinite;
  }

  .tech-track:hover {
    animation-play-state: paused;
  }

  .tech-chip {
    white-space: nowrap;
  }

  .tech-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    object-fit: contain;
    opacity: 0.62;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .tech-chip:hover .tech-icon {
    transform: scale(1.07);
    opacity: 0.95;
  }

  @keyframes stack-slide-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 767px) {
    .tech-track { animation-duration: 60s; }
  }

  @media (min-width: 768px) {
    .tech-track { animation-duration: 50s; }
  }
</style>
